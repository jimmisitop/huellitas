rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // FOTOS DE MASCOTAS
    // Ruta: pet-photos/{ownerUid}/{petId}/{fileName}
    // ============================================================
    match /pet-photos/{ownerUid}/{petId}/{fileName} {
      // Cualquier usuario autenticado puede VER fotos (son públicas)
      allow read: if request.auth != null;

      // Solo el dueño puede SUBIR fotos suyas
      allow create: if request.auth != null
                    && request.auth.uid == ownerUid
                    && request.resource.contentType.matches('image/.*');

      // Solo el dueño puede BORRAR sus fotos
      allow delete: if request.auth != null
                    && request.auth.uid == ownerUid;

      // No se permite sobreescritura directa (update)
      allow update: if false;
    }
  }
}
