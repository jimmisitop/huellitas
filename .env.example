# ============================================================
# Huellitas - Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env
#
# IMPORTANTE: Nunca commitees el archivo .env
# ============================================================

# ============================================================
# Firebase
# Obtener en: https://console.firebase.google.com/
# Proyecto: huellitas-9477e
# ============================================================
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=huellitas-9477e.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=huellitas-9477e
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=huellitas-9477e.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Cloudinary
# Obtener en: https://console.cloudinary.com/settings
# ============================================================
# Cloud Name (Settings → Cloud)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Upload Preset (Settings → Upload → Upload presets)
# Crear uno unsigned con:
#   - Nombre: huellitas_unsigned
#   - Modo: Unsigned
#   - Folder: huellitas
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=huellitas_unsigned

# ============================================================
# SerpApi
# Obtener en: https://serpapi.com/manage-api-key
# Plan gratuito: 100 búsquedas/mes
# ============================================================
EXPO_PUBLIC_SERPAPI_KEY=

# ============================================================
# Opcional: URLs de desarrollo
# ============================================================
# EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_WS_URL=ws://localhost:3000
